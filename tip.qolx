app "Tip Calculator"
accent #10b981
state bill = 50
state pct = 15

page
  card
    title "Tip calculator"
    input bill hint="Bill" type=number
    input pct hint="Tip %" type=number
    divider
    text "Tip: ${(bill * pct / 100).toFixed(2)}"
    text "Total: ${(bill * (1 + pct / 100)).toFixed(2)}"
